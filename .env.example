# LightMq Browser Environment Scaffolding
# Copy this file to .env for local overrides

# Application Mode
DEBUG=False
BROWSER_LOG_LEVEL=INFO

# WebEngine Configuration
# Chromium remote debugging port for DevTools protocol (0 = disabled)
DEVTOOLS_REMOTE_DEBUGGING_PORT=0

# Storage and Profile Paths (Leave blank to use OS default app data directory)
BROWSER_USER_DATA_DIR=
BROWSER_CACHE_DIR=

# Security & Policies
ENABLE_SANDBOX=True
DISABLE_WEB_SECURITY=False
