{
  "manifest_version": 3,
  "name": "LightMq Local Test Extension",
  "version": "1.0.0",
  "description": "A local-only extension fixture for verifying Qt WebEngine extension behavior.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
