/* LightMq - Light Theme QSS Scaffold */
QMainWindow {
    background-color: #F8F9FA;
    color: #202124;
}

QToolBar {
    background: #FFFFFF;
    border-bottom: 1px solid #DADCE0;
    spacing: 6px;
    padding: 4px;
}

QLineEdit {
    background-color: #F1F3F4;
    border: 1px solid transparent;
    border-radius: 16px;
    padding: 6px 14px;
    color: #202124;
    selection-background-color: #1A73E8;
}

QLineEdit:focus {
    background-color: #FFFFFF;
    border: 1px solid #1A73E8;
}

QTabBar::tab {
    background: #E8EAED;
    color: #3C4043;
    padding: 8px 16px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #202124;
}
